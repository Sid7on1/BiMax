{
  "name": "bimax",
  "version": "1.1.0",
  "description": "BiMax — Autonomous AI agent for your terminal",
  "bin": {
    "bimax": "bin/bimax.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node bin/bimax.js",
    "dev": "tsx src/index.ts",
    "build": "tsc && chmod +x bin/bimax.js",
    "build:engine": "bun build src/index.ts --compile --format=cjs --outfile .engine-local/bimax-engine && rm -f .*.bun-build",
    "postinstall": "node -e \"try{require('fs').existsSync(require('path').join(process.cwd(),'.breakglass','config.json'))||require('./scripts/postinstall')()}catch(e){}\"",
    "test": "jest --coverage",
    "test:ci": "jest --coverage=false",
    "doctor": "bash scripts/doctor.sh",
    "app:dev": "npm --prefix app run dev",
    "app:dist:mac": "npm --prefix app run dist:mac",
    "test:leaks": "jest --coverage=false --detectOpenHandles",
    "test:tui": "python3 scripts/tui-regression.py",
    "test:acp": "node scripts/smoke-acp.mjs",
    "test:computer": "tsx scripts/smoke-computer-use.ts",
    "test:computer:settings": "tsx scripts/smoke-system-settings.ts",
    "test:computer:settings-values": "tsx scripts/smoke-settings-values.ts",
    "test:computer:finder": "tsx scripts/smoke-finder-mouse.ts",
    "test:computer:pip": "tsx scripts/smoke-live-pip.ts",
    "test:computer:all": "tsx scripts/smoke-computer-all.ts",
    "test:computer:soak": "tsx scripts/soak-computer-use.ts",
    "test:computer:receipt-live": "tsx scripts/verify-computer-receipt-live.ts",
    "test:computer:range": "tsx scripts/smoke-computer-range.ts",
    "test:computer:range:row": "tsx scripts/smoke-computer-range.ts --layout row --targets 8",
    "test:computer:range:selftest": "tsx scripts/smoke-computer-range.ts --selftest",
    "benchmark:computer": "tsx scripts/benchmark-computer-targeting.ts",
    "benchmark:computer:color": "tsx scripts/benchmark-computer-color.ts",
    "benchmark:computer:receipts": "tsx scripts/benchmark-computer-receipts.ts",
    "benchmark:cu-baseline": "tsx scripts/benchmark-cu-baseline.ts",
    "benchmark:models": "tsx scripts/benchmark-model-routing.ts",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts'",
    "prepublishOnly": "npm run build",
    "gen:protocol": "tsc && node dist/protocol/schema/write.fixtures.js && node scripts/generate-protocol-package.mjs",
    "gen:protocol-package": "node scripts/generate-protocol-package.mjs",
    "gen:app-protocol": "node scripts/gen-app-protocol.mjs",
    "check:protocol-mirror": "node scripts/check-protocol-mirror.mjs",
    "verify:terminal-archives": "node scripts/verify-terminal-archives.mjs",
    "verify:terminal-protocol": "node scripts/verify-terminal-protocol.mjs",
    "verify:desktop-package": "node scripts/verify-desktop-package.mjs",
    "cu:phase0:check": "bash scripts/cu-phase0-local-gate.sh",
    "cu:phase1:check": "bash scripts/cu-phase1-local-gate.sh",
    "cu:phase2:check": "bash scripts/cu-phase2-local-gate.sh",
    "cu:phase3:check": "bash scripts/cu-phase3-local-gate.sh",
    "cu:phase4:check": "bash scripts/cu-phase4-local-gate.sh",
    "phase1:check": "bash scripts/phase1-local-gate.sh",
    "phase2:check": "node app/scripts/computer-use/conformance-bimax-cu-packaged.mjs app/release/mac-arm64/Bimax.app",
    "phase4:check": "bash scripts/phase4-local-gate.sh",
    "phase5:check": "bash scripts/phase5-local-gate.sh",
    "phase3:check": "bash scripts/phase3-local-gate.sh",
    "release:check": "bash scripts/release-gate.sh",
    "phase8:check": "bash scripts/phase8-local-gate.sh",
    "phase9:check": "bash scripts/phase9-local-gate.sh",
    "cu:x64-parity": "node app/scripts/verify-mac-provider-x64.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/rest": "^22.0.1",
    "async-mutex": "^0.5.0",
    "chalk": "^4.1.2",
    "cli-highlight": "^2.1.11",
    "cli-spinners": "^3.4.0",
    "commander": "^12.1.0",
    "cron-parser": "^5.5.0",
    "diff": "^4.0.4",
    "dockerode": "^5.0.0",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "fuzzysort": "^3.1.0",
    "gpt-tokenizer": "^3.4.0",
    "gradient-string": "^3.0.0",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.0.5",
    "minimatch": "^10.0.1",
    "openai": "^6.42.0",
    "puppeteer": "^21.0.0",
    "tree-sitter-wasms": "^0.1.13",
    "vscode-jsonrpc": "^9.0.0",
    "web-tree-sitter": "^0.20.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/diff": "^4.0.2",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.42",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^10.4.1",
    "jest": "^30.4.2",
    "prettier": "^3.8.4",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0"
  }
}
