{
  "name": "bimax",
  "version": "1.1.0",
  "description": "Bimax engine — the headless agent core the Bimax desktop app spawns",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "build:engine": "bun build src/index.ts --compile --minify-whitespace --minify-syntax --outfile .engine-local/bimax-engine && rm -f .*.bun-build",
    "postinstall": "node -e \"try{require('fs').existsSync(require('path').join(process.cwd(),'.breakglass','config.json'))||require('./scripts/postinstall')()}catch(e){}\"",
    "test": "jest --coverage",
    "test:ci": "jest --coverage=false",
    "test:context": "bun test ./src/__tests__/context.audit.acceptance.test.ts",
    "bench:context": "bun benchmarks/context/run.ts",
    "doctor": "bash scripts/doctor.sh",
    "app:dev": "npm --prefix app run dev",
    "app:dist:mac": "npm --prefix app run dist:mac",
    "test:leaks": "jest --coverage=false --detectOpenHandles",
    "test:acp": "node scripts/smoke-acp.mjs",
    "benchmark:models": "tsx scripts/benchmark-model-routing.ts",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts'",
    "prepublishOnly": "npm run build",
    "gen:protocol": "tsc && node dist/protocol/schema/write.fixtures.js && node scripts/generate-protocol-package.mjs",
    "gen:protocol-package": "node scripts/generate-protocol-package.mjs",
    "gen:app-protocol": "node scripts/gen-app-protocol.mjs",
    "check:protocol-mirror": "node scripts/check-protocol-mirror.mjs",
    "verify:desktop-package": "node scripts/verify-desktop-package.mjs",
    "phase8:check": "bash scripts/phase8-local-gate.sh",
    "phase9:check": "bash scripts/phase9-local-gate.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/rest": "^22.0.1",
    "@types/pg": "^8.23.1",
    "async-mutex": "^0.5.0",
    "chalk": "^4.1.2",
    "cli-highlight": "^2.1.11",
    "cli-spinners": "^3.4.0",
    "commander": "^12.1.0",
    "cron-parser": "^5.5.0",
    "diff": "^4.0.4",
    "dockerode": "^5.0.0",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "fuzzysort": "^3.1.0",
    "gpt-tokenizer": "^3.4.0",
    "gradient-string": "^3.0.0",
    "js-yaml": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.0.5",
    "minimatch": "^10.0.1",
    "openai": "^6.42.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pptxgenjs": "^4.0.1",
    "tree-sitter-wasms": "^0.1.13",
    "vscode-jsonrpc": "^9.0.0",
    "web-tree-sitter": "^0.20.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/diff": "^4.0.2",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.42",
    "@types/pdfkit": "^0.17.6",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^10.4.1",
    "jest": "^30.4.2",
    "prettier": "^3.8.4",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0"
  }
}
