.evolution_worktrees/
.env
coverage/
dist/
.breakglass/
# The engine that app/scripts/build-local-mac.sh compiles from src/ for a local desktop build.
# A build artifact of the CLI, consumed by the app — never a source of truth, never committed.
.engine-local/
src/**/evolve_staging_*
*.backup_*
# Covers node_modules, the node_modules.nosync real dir, AND iCloud conflict-copies like
# "node_modules 2" / "node_modules 10" (note the space) that get spawned on ~/Desktop.
node_modules*
build/
native/**/.build/
app/out-focus/
scripts/.*.tmp.ts

# Runtime logs / crash dumps written to cwd
fatal-crash.log
*.log

# Bundled native engines are fetched/built at runtime, never committed
vendor/*/bin/
vendor/*/cache/
vendor/*/venv/
vendor/

# macOS Finder litter
.DS_Store

# Raw master footage for the site (hundreds of MB — compressed derivatives live in site/public/media)
media-masters/

# Sub-agent runtime state (worktrees + capacity leases are per-machine, recreated on demand)
.bimax/worktrees/
.bimax/subagent-capacity.json

# Computer-use runtime state (browser profile/checkpoints + desktop screenshots — per-machine)
.bimax/browser/
.bimax/computer/

# Execution ledger (task-workspace journal — per-machine runtime state)
.bimax/execution/

# Third-party CLI local config
.grok/

# Bun --compile scratch blobs (60MB each) that bun leaves at cwd on a crash/interrupt
*.bun-build
.*.bun-build

# Mind layer — learned, machine-local state (plans/goals in .bimax stay tracked)
.bimax/self-model.json
.bimax/habits.json
.bimax/habits/
.bimax/user-model.json
.bimax/epistemic.json
.bimax/drives.json
.bimax/genome-patterns.jsonl
.bimax/dreams.json
.bimax/dogfood/
.bimax/ledger.db*
.bimax/episodes/
.bimax/exemplars.json
.bimax/tdm.json
.bimax/claims.json
# Per-machine command/tool counters (docs/product-reset/58). The GATES declaration beside it
# (.bimax/gates.json) is the opposite: hand-written, shared, and deliberately tracked.
.bimax/usage.json
.bimax/policy-arms.json
.bimax/workspace.json
.bimax/*.lock
benchmarks/terminal_bench_adapter/bin/

# Benchmark + agent run output (reproducible, large — never committed)
jobs/
runs/

# Python bytecode cache
__pycache__/
*.pyc

# OTel GenAI trace dumps (runtime artifact)
.bimax/traces/

# Local Claude Code workspace settings/agents (machine-local)
.claude/

# Locally-installed agent skills collection (machine-local, not part of the repo)
.agents/

# October (generated — context bus / browser MCP)
.claude/settings.local.json
.mcp.json
.codex/config.toml
.codex/hooks.json
.opencode/plugins/october-bus.js
opencode.json
.cursor/mcp.json
.cursor/cli.json
.gemini/settings.json
.bimax/harness-lab/
.bimax/harness-patches.json

# Live end-to-end run artifacts (generated by supervised computer-use runs, machine-local)
.bimax/e2e/

# Locally built native helpers (staged by scripts/stage-desktop-helper.ts; never committed)
app/native-service/
tui/embed/bimax-desktop-helper

# Transient benchmark runs. The FROZEN baseline is committed as
# benchmarks/cu-baseline/frozen-v1.1.0.json; ad-hoc runs are not evidence.
benchmarks/cu-baseline/baseline-*.json
