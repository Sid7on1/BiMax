{
  "name": "bimax-app",
  "productName": "Bimax",
  "version": "1.1.0",
  "description": "Bimax \u2014 an agentic coding IDE for project work",
  "main": "out/main/index.js",
  "private": true,
  "author": "Bimax",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:source": "BIMAX_ENGINE_CMD=\"$PWD/../node_modules/.bin/tsx $PWD/../src/index.ts\" electron-vite dev",
    "build": "electron-vite build",
    "build:focus-harness": "electron-vite build --config electron.vite.focus.config.ts",
    "typecheck": "tsc --noEmit",
    "prepare:engine": "bash scripts/prepare-engine.sh",
    "verify:engine": "electron scripts/verify-engine.js",
    "dist:mac": "electron-vite build && bash scripts/build-voice.sh arm64 && BIMAX_RELEASE_BUILD=1 bash scripts/prepare-engine.sh darwin-arm64 && electron-builder --mac --arm64 && node scripts/check-app-actions.mjs",
    "dist:mac:x64": "electron-vite build && bash scripts/build-voice.sh x64 && BIMAX_RELEASE_BUILD=1 bash scripts/prepare-engine.sh darwin-x64 && electron-builder --mac --x64 && node scripts/check-app-actions.mjs",
    "dist:mac:local": "electron-vite build && bash scripts/build-voice.sh arm64 && bash scripts/prepare-engine.sh darwin-arm64 && electron-builder --mac --arm64 -c.mac.entitlements=buildResources/entitlements.mac.local.plist -c.mac.entitlementsInherit=buildResources/entitlements.mac.local.plist -c.directories.output=${BIMAX_RELEASE_DIR:-/tmp/bimax-release} && node scripts/check-app-actions.mjs",
    "check:design-preview": "vite build --config design-preview/vite.config.ts --logLevel warn",
    "gen:motion": "node scripts/gen-motion-tokens.mjs",
    "check:motion": "node scripts/gen-motion-tokens.mjs --check",
    "check:glass-contrast": "node scripts/check-glass-contrast.mjs",
    "check:app-actions": "node scripts/check-app-actions.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.61",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@fontsource-variable/inter": "^5.2.8",
    "@lezer/highlight": "^1.2.3",
    "@lydell/node-pty": "^1.2.0-beta.12",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@shadcn/helpers": "^0.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.58",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "electron-liquid-glass": "^1.1.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.24.0",
    "marked": "^18.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^4.12.1",
    "react-virtuoso": "^4.18.10",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jest": "^30.4.2",
    "tailwindcss": "^4.0.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26"
  }
}
