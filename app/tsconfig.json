{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [
      "node",
      "jest"
    ]
  },
  "include": [
    "src",
    "electron.vite.config.ts",
    "electron.vite.focus.config.ts"
  ],
  "exclude": [
    "src/capabilities/mac/__tests__",
    "src/shared/__tests__",
    "src/phase9/__tests__"
  ]
}
